#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BUILD_DIR=".figma/make/dist"

cd "$ROOT_DIR"
rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cp ./*.html "$BUILD_DIR"/
cp -R css js "$BUILD_DIR"/

[[ -f "$BUILD_DIR/index.html" ]] || {
  echo "Expected static build output at $BUILD_DIR" >&2
  exit 1
}

figma make deploy --build-dir "$BUILD_DIR"
